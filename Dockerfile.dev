# syntax=docker/dockerfile:1
# Development image: installs deps, then runs the Next.js dev server.
# Source code is bind-mounted at runtime (see docker-compose.dev.yml),
# so edits on your host appear live with hot reload.
FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci
# Source is provided via a bind mount at runtime, not copied in.
EXPOSE 3000
CMD ["npm", "run", "dev"]
